# App
NEXT_PUBLIC_APP_URL=https://yehiortech.com

# Analytics (Required for production)
NEXT_PUBLIC_ANALYTICS_ID=

# Contact Form (Optional)
CONTACT_FORM_RECEIVER=contact@yehiortech.com

# Manager authentication — configure in Vercel, never commit real values
NEXT_PUBLIC_MANAGER_URL=https://manager.yehiortech.com
MANAGER_ADMIN_EMAIL=admin@yehiortech.com
MANAGER_ADMIN_PASSWORD=replace-with-a-strong-password
MANAGER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://manager.yehiortech.com/api/manager/google/callback
MANAGER_ALLOWED_EMAILS=admin@yehiortech.com

# Required before connecting durable CRM storage
DATABASE_URL=
