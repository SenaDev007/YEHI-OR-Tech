# YEHI OR Tech — Variables d'environnement
#
# ⚠️ La plupart des paramètres (numéro WhatsApp, email de contact, admin name,
# admin email, admin password, horaires, réseaux sociaux) sont stockés en base
# de données et éditables depuis /manager/settings. Aucune variable d'env n'est
# nécessaire pour ces valeurs.
#
# Variables réellement nécessaires :

# URL publique du site (pour SEO et metadata)
NEXT_PUBLIC_SITE_URL=https://yehiortech.com

# ============================================================
# Base de données (Prisma)
# Dev : SQLite  /  Prod : PostgreSQL (Neon, Supabase, Vercel Postgres)
# ============================================================
DATABASE_URL="file:./dev.db"
# Prod : DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ============================================================
# Sécurité — Secret pour signer les cookies JWT
# Génère avec : openssl rand -base64 64
# ⚠️ NE JAMAIS committer ce secret. Changer en prod.
# ============================================================
JWT_SECRET="dev-secret-change-me-in-production-please-use-64-chars-min-9f8a7c6d5e4b3a2f1d0e"

# ============================================================
# Compte admin initial (seed uniquement)
# ⚠️ Une fois seedé, ces valeurs sont en base. Modifiables depuis /manager/settings
# et via l'API /api/manager/profile et /api/manager/password.
# ============================================================
ADMIN_EMAIL="admin@yehiortech.com"
ADMIN_PASSWORD="YehiOr2026!"
ADMIN_NAME="Sènakpon AKPOVI"

# ============================================================
# FedaPay — Paiements (Mobile Money, Carte)
# Obtiens tes clés sur https://app.fedapay.com
# ============================================================
FEDAPAY_PUBLIC_KEY="pk_sandbox_xxx"
FEDAPAY_SECRET_KEY="sk_sandbox_xxx"

# ============================================================
# Resend — Envoi d'emails
# Obtiens ta clé sur https://resend.com
# ============================================================
RESEND_API_KEY=""
RESEND_FROM="noreply@yehiortech.com"
RESEND_TO="contact@yehiortech.com"
