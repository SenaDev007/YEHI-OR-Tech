# ============================================================
# YEHI OR Tech Backend — Variables d'environnement Railway
# ============================================================

# Port (Railway fournit automatiquement le PORT)
PORT=3001

# URL du frontend (CORS)
FRONTEND_URL=https://yehiortech.com

# Base de données PostgreSQL (Railway ou Neon/Supabase)
DATABASE_URL="postgresql://user:password@host:5432/yehi_or_tech?schema=public"

# Secret JWT (génère avec : openssl rand -base64 64)
JWT_SECRET="change-me-in-production"

# Resend (envoi d'emails — optionnel mais recommandé)
RESEND_API_KEY=""
RESEND_FROM="noreply@yehiortech.com"
RESEND_TO="contact@yehiortech.com"
