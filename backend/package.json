  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.14",
    "@types/pg": "^8.11.10",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
