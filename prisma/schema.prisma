// YEHI OR Manager — Schéma Prisma
// Architecture : offline-first, centres de profit, enveloppes de trésorerie, rôles.
// Dev : SQLite — Prod : PostgreSQL (DATABASE_URL=postgresql://…)
// Les enums sont convertis en String car SQLite ne supporte pas les enums Prisma.
// La validation des valeurs est assurée côté application (src/lib/types.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ORGANISATION & UTILISATEURS
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  customers Customer[]
  products  ProductService[]
  sales     Sale[]
  expenses Expense[]
  cashSessions CashSession[]
  stockItems StockItem[]
  envelopes TreasuryEnvelope[]
  subscriptions AcademiaSubscription[]
  orders    CustomerOrder[]
  siteSettings SiteSettings?
}

// ============================================================
// PARAMÈTRES DU SITE — éditables depuis /manager/settings
// (numéro WhatsApp, email contact, téléphone, horaires, réseaux sociaux)
// ============================================================

model SiteSettings {
  id              String   @id @default("default")
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappNumber  String   @default("2290141360803")
  contactEmail    String   @default("contact@yehiortech.com")
  phoneNumber     String   @default("+229 01 41 36 08 03")
  hours           String   @default("Lundi à samedi, 8h à 20h (GMT+1)")
  address         String   @default("Parakou, Bénin — Afrique de l'Ouest")
  socialLinkedin  String   @default("https://www.linkedin.com/company/yehi-or-tech")
  socialFacebook  String   @default("https://www.facebook.com/yehiortech")
  socialWhatsapp  String   @default("https://wa.me/2290141360803")
  updatedAt       DateTime @updatedAt

  createdAt       DateTime @default(now())
}

// Rôles possibles : ADMIN, RESPONSABLE, CAISSIER, PRODUCTION, SUPPORT_ACADEMIA, LECTURE_SEULE
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("RESPONSABLE")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sales       Sale[]
  expenses    Expense[]
  cashSessions CashSession[]
  allocations Allocation[]
  auditEvents AuditEvent[]
  stockMovements StockMovement[]

  @@index([organizationId])
}

// ============================================================
// CLIENTS & SERVICES
// ============================================================

// CustomerType : PARTICULIER, ECOLE, ENTREPRISE, ASSOCIATION
model Customer {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("PARTICULIER")
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sales         Sale[]
  orders        CustomerOrder[]
  subscriptions AcademiaSubscription[]

  @@index([organizationId])
}

// ProfitCenter : BOUTIQUE, DESIGN, TEXTILE, ACADEMIA, DEV
model ProductService {
  id          String   @id @default(cuid())
  name        String
  description String?
  unit        String   @default("unité")
  unitPrice   Float
  unitCost    Float?
  profitCenter String  @default("BOUTIQUE")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  saleLines SaleLine[]

  @@index([organizationId])
}

// ============================================================
// VENTES & PAIEMENTS
// ============================================================

// PaymentMethod : ESPECES, MOBILE_MONEY, VIREMENT, AUTRE
// SaleStatus : PAYEE, PARTIELLE, EN_ATTENTE, ANNULEE
model Sale {
  id           String   @id @default(cuid())
  number       String   // numéro visible : V-2026-001
  profitCenter String  @default("BOUTIQUE")
  status       String   @default("PAYEE")
  totalAmount  Float
  paidAmount   Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  cashSessionId  String?
  cashSession     CashSession? @relation(fields: [cashSessionId], references: [id])

  lines    SaleLine[]
  payments Payment[]
  allocations Allocation[]

  @@index([organizationId])
  @@index([createdAt])
  @@index([profitCenter])
}

model SaleLine {
  id           String  @id @default(cuid())
  quantity     Float
  unitPrice    Float
  totalAmount  Float

  saleId    String
  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   ProductService @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model Payment {
  id        String   @id @default(cuid())
  method    String   // ESPECES, MOBILE_MONEY, VIREMENT, AUTRE
  amount    Float
  reference String?  // n° mobile money, n° chèque…
  createdAt DateTime @default(now())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ============================================================
// CAISSE
// ============================================================

// CashSessionStatus : OUVERTE, CLOTUREE, ECART_NON_RESOLU
model CashSession {
  id          String   @id @default(cuid())
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  openingAmount Float
  closingAmount Float?
  theoreticalAmount Float?
  difference  Float?
  differenceNote String?
  status      String  @default("OUVERTE") // OUVERTE, CLOTUREE, ECART_NON_RESOLU

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User   @relation(fields: [userId], references: [id])

  sales Sale[]

  @@index([organizationId])
  @@index([status])
}

// ============================================================
// DÉPENSES
// ============================================================

model Expense {
  id          String   @id @default(cuid())
  number      String   // D-2026-001
  category    String
  amount      Float
  vendor      String?
  description String?
  receiptUrl  String?
  profitCenter String? // BOUTIQUE, DESIGN, TEXTILE, ACADEMIA, DEV
  envelopeId  String?
  envelope    TreasuryEnvelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User   @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

// ============================================================
// STOCKS
// ============================================================

model StockItem {
  id          String   @id @default(cuid())
  name        String
  category    String   // papier, toner, encre, fourniture
  unit        String
  quantity    Float
  threshold   Float    @default(0)
  unitCost    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  movements StockMovement[]

  @@index([organizationId])
}

// StockMovementType : ENTREE, SORTIE, CORRECTION, INVENTAIRE
model StockMovement {
  id        String   @id @default(cuid())
  type      String
  quantity  Float
  reason    String?
  createdAt DateTime @default(now())

  itemId String
  item   StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String?
  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([itemId])
}

// ============================================================
// TRÉSORERIE
// ============================================================

model TreasuryEnvelope {
  id          String   @id @default(cuid())
  name        String
  description String?
  target      Float?
  balance     Float    @default(0)
  isOperational Boolean @default(false)
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  allocations Allocation[]
  expenses    Expense[]

  @@index([organizationId])
}

model Allocation {
  id          String   @id @default(cuid())
  amount      Float
  percent     Float?
  reason      String?
  createdAt   DateTime @default(now())

  envelopeId String
  envelope   TreasuryEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([envelopeId])
}

// ============================================================
// COMMANDES & ACADEMIA
// ============================================================

// OrderStatus : NOUVELLE, EN_PRODUCTION, PRETE, LIVREE, ANNULEE
model CustomerOrder {
  id          String   @id @default(cuid())
  number      String   // C-2026-001
  title       String
  description String?
  deadline    DateTime?
  price       Float
  advancePaid Float   @default(0)
  status      String   @default("NOUVELLE")
  profitCenter String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

// AcademiaSubscriptionStatus : ACTIF, ESSAI, SUSPENDU, RESILIE, IMPAYE
model AcademiaSubscription {
  id           String   @id @default(cuid())
  schoolName   String
  contactName  String?
  contactPhone String?
  contactEmail String?
  monthlyFee   Float
  startedAt    DateTime @default(now())
  endsAt       DateTime?
  status       String   @default("ACTIF")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
}

// ============================================================
// AUDIT & SYNC
// ============================================================

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// SyncStatus : EN_ATTENTE, SYNCHRONISEE, ERREUR
model SyncOperation {
  id          String   @id @default(cuid())
  localId     String   @unique
  operationType String
  payload     String
  status      String  @default("EN_ATTENTE")
  error       String?
  createdAt   DateTime @default(now())
  syncedAt    DateTime?

  @@index([status])
}

// ============================================================
// RÉINITIALISATION MOT DE PASSE
// ============================================================

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================================
// CONTENU PUBLIC ÉDITABLE DEPUIS LE MANAGER (pattern Win-Agro)
// ============================================================
// Ces modèles remplacent les fichiers statiques src/data/*.ts.
// Toutes les pages publiques (home, services, portfolio, tarifs, about)
// lisent leur contenu depuis ces tables via l'API.
// Le manager expose des interfaces CRUD pour chaque type.

model ServiceContent {
  id              String   @id @default(cuid())
  slug            String   @unique // "informatique-assistance"
  number          String?  // "01", "02"...
  title           String
  icon            String   @default("Code") // nom lucide-react
  tagline         String
  availability    String   @default("sur-devis") // immediate | sur-devis | produit
  availabilityLabel String @default("Sur devis")
  problem         String?  @db.Text
  fullDescription String?  @db.Text
  deliverables    String[] @default([])
  targetAudience  String[] @default([])
  commercialLimit String?  @db.Text
  formFields      String[] @default([])
  faq             Json?    // [{ question, answer }]
  tags            String[] @default([])
  cta             String   @default("Démarrer ce service →")
  gradient        String   @default("linear-gradient(135deg, #F5B700 0%, #071A2F 100%)")
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("service_contents")
}

model StatContent {
  id          String   @id @default(cuid())
  value       Int
  suffix      String?
  label       String
  meaning     String?  @db.Text
  section     String   @default("homepage") // homepage | whyChooseUs
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stat_contents")
}

model PortfolioItem {
  id            String   @id @default(cuid())
  slug          String   @unique // "academia-helm"
  title         String
  category      String
  categorySlug  String   @default("applications")
  description   String?  @db.Text
  tags          String[] @default([])
  status        String   @default("live") // live | development | concept
  statusLabel   String   @default("En production")
  gradient      String   @default("linear-gradient(135deg, #F5B700 0%, #071A2F 100%)")
  iconName      String   @default("Code")
  tech          String[] @default([])
  url           String?
  previewImage  String?
  isActive     Boolean  @default(true)
  order         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("portfolio_items")
}

model PricingPack {
  id                String   @id @default(cuid())
  slug              String   @unique // "site-vitrine"
  name              String
  price             Int                  // FCFA
  currency          String   @default("FCFA")
  period            String?              // "mois" | "projet" | "an" | "one-shot"
  description       String?  @db.Text
  tagline           String?  @db.Text
  features          String[] @default([])
  featureDetails    Json?     // [{ label, detail }]
  cta               String   @default("Choisir ce pack")
  badge             String?
  badgeColor        String?  // blue | gold | dark | green
  color             String?  // blue | gold | dark | green
  category          String?  // credibilite | web | application | ia | impression
  deliveryTime      String?
  supportIncluded   String?
  isPopular         Boolean  @default(false)
  isActive          Boolean  @default(true)
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pricing_packs")
}

model Testimonial {
  id           String   @id @default(cuid())
  text         String   @db.Text
  highlight    String?
  authorName   String
  authorRole   String
  authorAvatar String?
  rating       Int      @default(5) // 1-5
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

model PageContent {
  id        String   @id @default(cuid())
  page      String   // "home" | "about" | "services" | "contact"
  section   String   // "hero" | "intro" | "values" | etc.
  key       String   // "title" | "subtitle" | "description"
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([page, section, key])
  @@map("page_contents")
}

// ============================================================
// AUTRES CONTENUS ÉDITABLES (valeurs, processus, FAQ)
// ============================================================

model ValueContent {
  id          String   @id @default(cuid())
  number      String?  // "01", "02"...
  title       String
  description String?  @db.Text
  icon        String   @default("Star") // nom lucide-react
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("value_contents")
}

model ProcessStepContent {
  id          String   @id @default(cuid())
  number      String?  // "01", "02"...
  title       String
  description String?  @db.Text
  icon        String   @default("Search")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("process_step_contents")
}

model FAQItem {
  id          String   @id @default(cuid())
  question   String
  answer     String   @db.Text
  category   String   @default("general") // general | services | pricing | etc.
  isActive   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faq_items")
}

// ============================================================
// SAAS HUB — Hub de contrôle des applications SaaS développées
// ============================================================
// Pattern : le manager YEHI OR Tech devient le hub central pour piloter
// toutes les apps SaaS développées (Academia Helm, Win Agro, etc.).
// Chaque app expose son API ; le manager stocke un miroir local + appelle l'API.

model SaasApp {
  id          String   @id @default(cuid())
  slug        String   @unique // "academia-helm"
  name        String
  description String?  @db.Text
  icon        String   @default("App")
  apiUrl      String?  // https://api.academiahelm.com
  apiKey      String?  // token d'auth API (si nécessaire)
  publicUrl   String?  // https://academiahelm.com
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants     SaasTenant[]

  @@map("saas_apps")
}

model SaasTenant {
  id                String   @id @default(cuid())
  appId             String
  externalId        String?  // ID du tenant dans l'API distante
  name              String   // nom de l'école/établissement
  slug              String?  // sous-domaine ou slug
  contactName       String?  // promoteur
  contactEmail      String?
  contactPhone      String?
  // ⭐ Plans Academia Helm — codes du contrat (Article 4)
  // SEED = Helm Essentiel (1-50), GROW = Helm Croissance (51-150),
  // LEAD = Helm Performance (151-400), NETWORK = Helm Institution (401+)
  plan              String   @default("SEED")
  status            String   @default("trial") // trial | active | suspended | cancelled | grace_period
  studentCount      Int      @default(0)
  studentMin        Int      @default(1) // tranche min du plan
  studentMax        Int?     // tranche max du plan (null = illimité)
  billingCycle      String   @default("ANNUAL") // ANNUAL | MONTHLY | ONE_TIME (Academia Helm = ANNUAL)
  amount            Int      @default(0) // montant de base
  // ⭐ Academia Helm : frais d'activation one-shot + frais annuels
  initialFee        Int      @default(0) // 300000 FCFA (one-shot)
  initialFeePaid    Boolean  @default(false)
  yearlyAmount      Int      @default(0) // 50000 | 75000 | 100000 | 150000
  // ⭐ Option bilingue FR/EN (+50000 FCFA/an)
  bilingualEnabled  Boolean  @default(false)
  bilingualAmount   Int      @default(0) // 50000 FCFA/an si activé
  // ⭐ Multi-campus (réseaux d'écoles)
  schoolsCount      Int      @default(1)
  // ⭐ Dates clés du contrat Academia Helm
  startDate         DateTime @default(now())
  activationDate    DateTime? // date de paiement des frais d'activation
  trialEndsAt       DateTime?
  annualDueDate     DateTime? // échéance annuelle (1 an après activation)
  nextPaymentDueAt  DateTime?
  cancelledAt       DateTime?
  // Sync avec API distante
  metadata          Json?
  lastSyncAt        DateTime?
  syncStatus        String   @default("pending") // pending | synced | error
  syncError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  app               SaasApp  @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
  @@index([status])
  @@index([plan])
  @@index([nextPaymentDueAt])
  @@index([annualDueDate])
  @@map("saas_tenants")
}
